# 8ball — environment for the ONE stateless function (netlify/functions/activate.mjs, DOCTRINE §12 v0.91).
# Set these in the Netlify site environment, never in the repository. `.env` is gitignored.
#
# key 1's PRIVATE JWK as one line of JSON ({"kty":"EC","crv":"P-256","d":"…","x":"…","y":"…"}).
# Its public half is DYAD_PUBLIC_KEYS[0] in core/entitlement.js. Never remove a public key once a
# sale has been signed under it; rotate by APPENDING (audits/dyad_entitlement_launch_config_2026-09-05.md).
DYAD_SIGNING_KEY=
# the product's Gumroad permalink slug (the Buy Link is https://theeightball.gumroad.com/l/<slug>)
GUMROAD_PRODUCT_PERMALINK=dyad
# local development ONLY: with `netlify dev` (NETLIFY_DEV=true) and this flag, the key
# 00000000-00000000-00000000-00000000 verifies as a stub sale. Ignored everywhere else.
DYAD_VERIFY_STUB=
